# ============================================================
# OOREDOO RESELLER API — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

NODE_ENV=development
PORT=3001

# ── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ooredoo_reseller
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_POOL_MAX=20

# ── JWT ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=8h

# ── Security ──────────────────────────────────────────────────
BCRYPT_ROUNDS=12
CORS_ORIGIN=https://competent-stars-ozone-gamma.trycloudflare.com

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10

# ── Error Monitoring (optional) ───────────────────────────────
# Leave empty in development. In production, set to your Sentry DSN.
SENTRY_DSN=
